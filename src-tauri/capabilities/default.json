{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the tray window and the supervised model-proxy-v3 sidecar.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [{ "name": "binaries/model-proxy-v3", "sidecar": true, "args": true }]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [{ "name": "binaries/model-proxy-v3", "sidecar": true, "args": true }]
    },
    "shell:allow-stdin-write",
    "shell:allow-kill"
  ]
}
