{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "proxy-tray",
  "version": "0.1.0",
  "identifier": "com.qidu.proxytray",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Model Proxy V3",
        "width": 560,
        "height": 460,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "externalBin": [
      "/Users/claw/dev/bot/model_proxy_v3/dist/model-proxy-v3"
    ]
  },
  "plugins": {
    "proxy-tray": {
      "port": 8788
    }
  }
}
